# Export explicitly after editing: set -a; source .env; set +a
# Copy to .env and fill in. Never commit .env (it's gitignored).
# Kalshi market data is public: no Kalshi key is needed for paper trading.

# Where DraftKings odds come from: oddsapi (default) or nash.
#   oddsapi  The Odds API, bookmaker "draftkings". Needs ODDS_API_KEY from
#            https://the-odds-api.com. Each odds read costs one credit per league;
#            each results read (the draftkings monitor) costs two.
#   nash     DraftKings' undocumented sportscontent feed. DraftKings' CDN refuses
#            many non-browser clients with HTTP 403; this client reports that and
#            stops. Bets from this source are settled with `czquant settle-sportsbook`.
DRAFTKINGS_SOURCE=oddsapi
ODDS_API_KEY=

# nash only: the DraftKings state site, e.g. dkusnj (New Jersey), dkusny, dkusoh.
# DRAFTKINGS_SITE=dkusnj

# Paper stake limit per selection, in dollars (the monitor and trader share it).
# DRAFTKINGS_MAX_STAKE=500

# Credits kept for results reads; the trader never spends them on odds.
# ODDS_API_RESERVE=40
# The DraftKings monitor reads results per league at most this often, and only for
# games that started this many hours ago.
# DRAFTKINGS_RESULTS_MINUTES=30
# DRAFTKINGS_SETTLE_AFTER_HOURS=2.5

# Shared broker: the absolute runs directory and an explicitly created portfolio.
STRATEGY_RUNS_DIR=
CZQUANT_PORTFOLIO=cross-market-sportbook

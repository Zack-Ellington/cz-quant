# Copy this file to .env and fill in the values. Never commit .env.

# Kalshi API key. Create one at https://kalshi.com/account/profile (API Keys).
# Kalshi gives you a key ID and an RSA private key file. Keep the key file
# outside the repo, or under this directory (*.pem and *.key are gitignored).
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Demo environment by default. Demo keys and production keys are separate.
# Production: https://external-api.kalshi.com/trade-api/v2
KALSHI_API_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2

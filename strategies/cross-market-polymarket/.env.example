# Export explicitly after editing: set -a; source .env; set +a
# Copy to .env and fill in. Never commit .env (it's gitignored).

# --- Shared broker -----------------------------------------------------------
# The absolute runs directory every strategy, monitor and the dashboard share, and
# an explicitly created paper portfolio (uv run czquant portfolio cross-market-polymarket).
STRATEGY_RUNS_DIR=
CZQUANT_PORTFOLIO=cross-market-polymarket
# Kalshi reads per second shared by every process on this machine (default 15).
# KALSHI_SHARED_RPS=15

# --- Kalshi ------------------------------------------------------------------
# Market data is public: paper trading needs no Kalshi key. The account monitor and
# any live trading need a production key (Account > API keys on kalshi.com).
KALSHI_API_KEY_ID=
# A path to the private key's .pem file, kept outside the repo.
KALSHI_PRIVATE_KEY_PATH=
# KALSHI_API_BASE_URL=https://external-api.kalshi.com/trade-api/v2

# --- Polymarket: public data (paper trading uses only these) -------------------
# Events, markets, fee schedules and results; and outcome-token order books.
# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
# POLYMARKET_CLOB_URL=https://clob.polymarket.com

# --- Polymarket: trading credentials (not used yet) ----------------------------
# Paper trading never reads these. They are what Polymarket's CLOB needs to place
# real orders, listed so a live adapter can be added without changing this file's
# layout. Check that Polymarket permits trading from your jurisdiction first.
#
# The Polygon wallet that signs orders (L1). Keep the key in a file outside the
# repo, like the Kalshi key; never paste it here.
POLYMARKET_PRIVATE_KEY_PATH=
# The address that holds your funds: your Polymarket profile's proxy wallet when you
# signed up with email or a browser wallet; the signer's own address otherwise.
POLYMARKET_FUNDER_ADDRESS=
# How orders are signed: 0 = the key's own wallet (EOA), 1 = an email/Magic proxy
# wallet, 2 = a browser-wallet (Gnosis Safe) proxy.
POLYMARKET_SIGNATURE_TYPE=
# CLOB API credentials (L2), created or derived once from the wallet
# (POST /auth/api-key or GET /auth/derive-api-key) and sent on every trading request.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
# Polygon mainnet.
POLYMARKET_CHAIN_ID=137

# --- Oddpool: pair discovery (find_pairs.py only) -------------------------------
# Oddpool's search indexes Kalshi and Polymarket series side by side, so find_pairs.py
# pairs related series first and markets within them. Any plan includes search
# (oddpool.com). Without a key, find_pairs.py falls back to scanning both venues.
ODDPOOL_API_KEY=
# ODDPOOL_URL=https://api.oddpool.com

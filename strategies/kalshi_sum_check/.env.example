# Copy to .env and fill in. Never commit .env (it's gitignored).
# Production keys only: demo keys can't see production markets.
# Create the key at https://kalshi.com (Account > API keys). Kalshi shows the key ID
# and its private key once: RSA from Kalshi, or an RSA or Ed25519 key you registered.

# The key ID (a UUID). KALSHI-ACCESS-KEY also works, but only from this file:
# shells can't export names with hyphens.
KALSHI_API_KEY_ID=

# The private key: a path to the .pem file (keep it outside the repo)...
KALSHI_PRIVATE_KEY_PATH=
# ...or the PEM text itself on one line, with newlines written as \n.
# KALSHI_PRIVATE_KEY=

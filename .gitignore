# Secrets: every strategy has its own .env. Only .env.example is committed.
.env
*.pem
*.key

# The template has no lockfile. Each real strategy commits its own uv.lock.
strategies/_template/uv.lock

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Tools
.ruff_cache/
.pytest_cache/
.DS_Store

# Paper-trading run directories (one per run, per strategy); see issue #7.
/runs/
# Runs created from inside a strategy directory when STRATEGY_RUNS_DIR is unset.
strategies/*/runs/

# Private experiment configs and prepared inputs; only the example is published.
/experiments/*
!/experiments/example/
/experiments/example/candidates.json

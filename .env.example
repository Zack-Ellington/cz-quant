# Copy to .env, edit, then export: set -a; source .env; set +a
# Public-data paper experiments need no credentials. Keep real keys outside Git.

# Persistent private state outside the checkout. Use the same absolute path in
# portfolio, strategy, monitor and reporting shells.
STRATEGY_RUNS_DIR=/absolute/path/to/czquant-runs

# Kalshi production API key ID and path to its RSA private key (.pem).
# Required for authenticated account monitoring and live execution.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Polymarket US API key ID and path to a file containing its base64 secret.
# Required for authenticated account monitoring and live execution.
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY_PATH=
